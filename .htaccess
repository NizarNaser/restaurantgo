<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve real files/directories (assets, robots.txt, sitemap.xml, ...) as-is.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else is a client-side route — let the SPA's router handle it.
    RewriteRule ^ index.html [L]
</IfModule>
