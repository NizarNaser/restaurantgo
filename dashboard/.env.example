VITE_API_URL=http://localhost:8000/api

# Must match the API's APP_BASE_DOMAIN. When set, a request to
# {subdomain}.{this} is served as that tenant's public site at clean root
# paths (/, /halls, /cart, ...) instead of the legacy /p/:slug/... prefix —
# see src/lib/publicSite.ts. Leave unset in local dev (no wildcard DNS).
VITE_BASE_DOMAIN=

# Optional — leave unset to disable frontend error monitoring entirely.
VITE_SENTRY_DSN=
