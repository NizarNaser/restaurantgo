# Production template for Hostinger Business (see HOSTINGER_BUSINESS_DEPLOYMENT.md §4).
# Copied to .env on the server on first setup. NEVER put real secrets in this file —
# fill DB_*, MAIL_*, STRIPE_* and OPENAI_API_KEY only in the server's .env.
APP_NAME=RestaurantGo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.restaurantgo.org

# Left empty on purpose: per-tenant subdomains don't work on Hostinger
# Business (tested 2026-09-30 — no Wildcard SSL option on this plan; see §9
# of HOSTINGER_BUSINESS_DEPLOYMENT.md). Restaurants are served at
# https://app.restaurantgo.org/p/{slug} instead.
APP_BASE_DOMAIN=
APP_PUBLIC_URL=https://app.restaurantgo.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@restaurantgo.org"
MAIL_FROM_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# Empty = all AI features disabled without errors.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
