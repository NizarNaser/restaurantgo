VITE_API_URL=http://localhost:8000/api

# Where each restaurant's own public menu/blog pages are served from (the `dashboard` app's /p/:slug routes).
VITE_RESTAURANT_SITE_URL=http://localhost:5173

# Must match the API's APP_BASE_DOMAIN. When set, the "your page is live at"
# link shown right after registration points at https://{subdomain}.{this} —
# leave unset in local dev, where there's no wildcard DNS to make that resolve.
VITE_BASE_DOMAIN=

# Optional — leave unset to disable frontend error monitoring entirely.
VITE_SENTRY_DSN=
